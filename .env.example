# 复制为 .env 后再 docker compose up。.env 不进版本库。
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
REDIS_PASSWORD=change-me-three

# 本地 compose 默认把邮件投到 mailpit（http://localhost:8025 查看）。
# 上线时换成真实 SMTP，例如：
# SPRING_MAIL_HOST=smtp.exmail.qq.com
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=no-reply@your-domain
# SPRING_MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SSL=true
MAIL_FROM=mathematics <no-reply@mathematics.local>

# 前面有 Nginx / SLB 时才设 true，否则任何人都能伪造 X-Forwarded-For 绕过按 IP 限流
TRUST_FORWARDED_FOR=false
